   "source": [
    "inp = int(input())\n",
    "\n",
    "n = input()\n",
    "nums = n.split()\n",
    "min = int(nums[0])\n",
    "max = int(nums[0])\n",
    "\n",
    "for i in range(inp) :\n",
    "    if min > int(nums[i]) :\n",
    "        min = int(nums[i])\n",
    "\n",
    "    if max < int(nums[i]) :\n",
    "        max = int(nums[i])\n",
    "\n",
    "print(min,max)\n",
    "\n"
   ]
