     "name": "stdout",
     "output_type": "stream",
     "text": [
      "on\n"
     ]
    }
   ],
   "source": [
    "inp = input()\n",
    "\n",
    "nums = inp.split()\n",
    "\n",
    "brightness = int(nums[0])\n",
    "threshold = int(nums[1])\n",
    "\n",
    "if brightness >= threshold :\n",
    "    print(\"on\")\n",
    "else :\n",
    "    print(\"off\")\n",
    "\n",
    "\n"
   ]
  }
