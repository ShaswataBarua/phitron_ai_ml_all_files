    "inp = int(input())\n",
    "n = input()\n",
    "nums= n.split()\n",
    "count = 0\n",
    "\n",
    "for i in range(inp) :\n",
    "    if int(nums[i])%2 == 0 :\n",
    "        count+=1\n",
    "    \n",
    "\n",
    "print(count)\n",
    "              "
