    "inp = int(input())\n",
    "n = input()\n",
    "\n",
    "nums = n.split()\n",
    "max =0\n",
    "\n",
    "for i in range(inp):\n",
    "    if int(nums[i]) > 100 :\n",
    "        max = int(nums[i])\n",
    "        break\n",
    "\n",
    "print(max)"
