   "source": [
    "t = int(input())\n",
    "\n",
    "for i in range(t) :\n",
    "    num =int(input())\n",
    "    if num==0 :\n",
    "        print(0)\n",
    "    else :\n",
    "        while num > 0 :\n",
    "                dig = num%10\n",
    "                print(dig,end=\" \")\n",
    "                num//=10\n",
    "        print()\n",
    "\n",
